# hotline deployment secrets (macOS example) -- copy to
# ~/.config/hotline/hotline.env and fill in real values, then lock it down:
#
#   cp deploy/macos/hotline.env.example ~/.config/hotline/hotline.env
#   chmod 600 ~/.config/hotline/hotline.env
#
# This file is sourced by deploy/macos/hotline-run.sh (the launchd wrapper). It
# holds SECRETS only; keep it out of version control. Non-secret settings
# (stream_url, poll interval, model size, ...) live in
# ~/.config/hotline/config.toml -- see config.example.toml. Never put secrets
# in the TOML file.

# Telegram Bot API token from @BotFather. Required to send alerts.
HOTLINE_TELEGRAM_TOKEN=
# Destination chat id for alerts (your user id, or a group/channel id).
HOTLINE_CHAT_ID=
# Optional API key for an OpenAI-compatible chat API, used ONLY when the
# [summary] table in config.toml sets mode = "llm". Leave commented out to use
# the default local "rules" summariser (no network, no key needed).
# HOTLINE_SUMMARY_API_KEY=
