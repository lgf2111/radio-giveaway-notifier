# hotline deployment secrets (example) -- copy to /etc/hotline/hotline.env and
# fill in real values. This file is read by the systemd unit (EnvironmentFile)
# or by `docker run --env-file`. It holds SECRETS only; keep it out of version
# control and lock it down (chmod 600, owned by the hotline user).
#
# Non-secret settings (stream_url, poll interval, model size, ...) live in
# /etc/hotline/config.toml -- see config.example.toml. Never put secrets there.

# Telegram Bot API token from @BotFather. Required to send alerts.
HOTLINE_TELEGRAM_TOKEN=
# Destination chat id for alerts (your user id, or a group/channel id).
HOTLINE_CHAT_ID=
# Optional API key for an OpenAI-compatible chat API, used ONLY when the
# [summary] table in config.toml sets mode = "llm". Leave commented out to use
# the default local "rules" summariser (no network, no key needed).
# HOTLINE_SUMMARY_API_KEY=
