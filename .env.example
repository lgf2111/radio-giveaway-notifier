# hotline secrets (example)
#
# Copy this file to `.env` and fill in your values, or export these variables
# in your shell. hotline reads secrets ONLY from the environment -- never from
# config.toml -- so they can never be committed with a config file.
#
# Load them before running, e.g.:
#   set -a; source .env; set +a
#   uv run python -m hotline watch --config config.toml

# Telegram Bot API token from @BotFather. Required to send alerts.
HOTLINE_TELEGRAM_TOKEN=

# Destination chat id for alerts (your user id, or a group/channel id).
HOTLINE_CHAT_ID=

# Optional X (Twitter) API bearer token. The social source polls X only when
# this is set; otherwise it is a no-op.
HOTLINE_X_BEARER=

# Optional Instagram Graph API access token. The social source polls Instagram
# only when this is set; otherwise it is a no-op.
HOTLINE_IG_TOKEN=

# Optional API key for an OpenAI-compatible chat API, used ONLY when the
# [summary] table sets mode = "llm". Leave unset to use the default local
# "rules" summariser (no network, no key needed).
# HOTLINE_SUMMARY_API_KEY=
